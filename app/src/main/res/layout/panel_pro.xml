<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_panel"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="EV"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/sbEv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="8"
            android:progress="4"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <TextView
            android:id="@+id/tvEv"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="end"
            android:text="0.0"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="ISO"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/sbIso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="7"
            android:progress="0"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <TextView
            android:id="@+id/tvIso"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="end"
            android:text="自动"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="S"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/sbShutter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="8"
            android:progress="0"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <TextView
            android:id="@+id/tvShutter"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="end"
            android:text="自动"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="WB"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/sbWb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="4"
            android:progress="0"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <TextView
            android:id="@+id/tvWb"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="end"
            android:text="自动"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
